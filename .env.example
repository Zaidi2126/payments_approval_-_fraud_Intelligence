# Copy to .env and set values. .env is gitignored.
# SECRET_KEY=your-secret-key
# DEBUG=True

# Optional: Slack Incoming Webhook URL for daily summary (python manage.py send_daily_slack_summary)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# LLM explanations (reasons and counterfactuals). If missing, deterministic fallback is used.
# OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_OUTPUT_TOKENS=500
